# Phato Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# =================================
# Database Configuration
# =================================
# MongoDB connection string (Required)
MONGODB_URI=mongodb://localhost:27017/phato

# =================================
# AI Services Configuration
# =================================
# Google Gemini API key for content analysis (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# =================================
# Vector Database Configuration (Qdrant)
# =================================
# For local development (free, unlimited vectors):
QDRANT_URL=http://localhost:6333

# For production (Qdrant Cloud - 1M vectors free):
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here

# Collection name (Optional - defaults to 'phato-news')
QDRANT_COLLECTION=phato-news

# =================================
# News API Configuration
# =================================
# NewsAPI.org API key (Required)
NEWS_API_KEY=your_newsapi_key_here

# The Guardian API key (Optional)
GUARDIAN_API_KEY=your_guardian_api_key_here

# New York Times API key (Optional)
NYT_API_KEY=your_nyt_api_key_here

# =================================
# Embedding Model Configuration
# =================================
# Embedding model name (Optional - defaults to 'BAAI/bge-large-en-v1.5')
EMBEDDINGS_MODEL=BAAI/bge-large-en-v1.5

# Embedding vector dimension (Optional - defaults to 1024)
EMBEDDINGS_DIMENSION=1024

# Cache directory for models (Optional - defaults to './models')
EMBEDDINGS_CACHE_DIR=./models

# =================================
# Local LLM Service Configuration
# =================================
# URL for the Python LLM microservice (Optional - defaults to 'http://localhost:8001')
LLM_SERVICE_URL=http://localhost:8001

# Request timeout for LLM service in milliseconds (Optional - defaults to 60000)
LLM_REQUEST_TIMEOUT=60000

# =================================
# Server Configuration
# =================================
# Server port (Optional - defaults to 3000)
PORT=3000

# Node environment (Optional - defaults to 'development')
NODE_ENV=development

# =================================
# CORS Configuration
# =================================
# Comma-separated list of allowed origins (Optional)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Allow all origins for development (Optional - defaults to false)
ALLOW_ALL_ORIGINS=true